# 大模型配置（OpenAI兼容接口，DeepSeek/通义/智谱都支持）
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Embedding配置（智谱Embedding，免费额度够用）
EMBEDDING_API_KEY=your-zhipu-key
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3

# 天气API（和风天气：https://dev.qweather.com/）
WEATHER_API_KEY=your-qweather-key

# 高德地图API：https://lbs.amap.com/
AMAP_API_KEY=your-amap-key

# 联网搜索API（博查搜索：https://api.bochaai.com/）
SEARCH_API_KEY=your-bocha-key
